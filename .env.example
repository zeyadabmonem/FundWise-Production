# =============================================================================
# FundWise Production Environment Configuration
# =============================================================================

# Server Port
PORT=3000
NODE_ENV=development

# Database Connection
# Supported: postgresql://username:password@localhost:5432/fundwise
# If left empty, FundWise automatically falls back to local sqlite storage for immediate zero-config testing.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fundwise

# Session Security
# 64-character random hex string for signing & securing session cookies
SESSION_SECRET=a8f93e2b4c10567d890ef123456789abcdef1234567890abcdef1234567890ab

# Google Gemini API Key (Recommended - Free Tier with 15 req/min)
# Powers Gemini Flash Vision receipt OCR and Egyptian dialect voice/text parsing.
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI API Key (Optional alternative for live Whisper voice & GPT-4o-mini receipt/categorization)
# If empty, FundWise runs with smart offline rule-based extraction for zero-friction local dev.
OPENAI_API_KEY=

# Admin Accounts
# Comma-separated list of emails that automatically receive the 'admin' role upon registration or signin
ADMIN_EMAILS=admin@fundwise.eg,admin@example.com

# SerpAPI Key (for AI Alternatives real product search)
# Powers real Google Shopping product results for Egypt (gl=eg).
# Free tier: 250 searches/month. Get key at: https://serpapi.com
# The alternatives endpoint returns no offers until this provider is configured.
# FundWise intentionally does not fall back to AI-generated commerce facts.
SERP_API_KEY=

# CORS Configuration
CORS_ORIGIN=http://localhost:5173
